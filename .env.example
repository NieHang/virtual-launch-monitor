# Telegram BotFather token. Leave empty to run the monitor without Telegram delivery.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs. When empty, all users are allowed.
# Example: TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# Embedded SQLite file; the directory is created automatically.
SQLITE_PATH=./data/monitor.sqlite

# Chain events are the primary low-latency launch signal. For production, replace
# these public rate-limited endpoints with dedicated provider URLs.
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_POLL_MS=1000

# Official latest-page polling is retained only as a fallback.
OFFICIAL_API_POLL_MS=5000

# An unseen API item older than this is recorded but never notified.
LIVE_LAUNCH_MAX_AGE_MS=300000

PORT=3000
LOG_LEVEL=info
